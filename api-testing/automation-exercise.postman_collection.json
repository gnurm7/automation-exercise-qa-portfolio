         "key": "mobile_number",
         "value": "4165550100",
         "type": "text"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "exec": [
         "const id = pm.variables.replaceIn(\"{{$guid}}\");",
         "pm.collectionVariables.set(\"email\", \"ae-\" + id + \"@example.com\");",
         "pm.collectionVariables.set(\"password\", \"Demo-\" + id + \"!\");"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test(\"HTTP status is 200\", () => { pm.response.to.have.status(200); });",
         "const body = pm.response.json();",
         "pm.test(\"Application responseCode is 201\", () => { pm.expect(body.responseCode).to.eql(201); });",
         "pm.test(\"Application message matches contract\", () => { pm.expect(body.message).to.eql(\"User created!\"); });"
        ]
       }
      }
     ]
