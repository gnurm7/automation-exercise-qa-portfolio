   "name": "Catalogue and request validation",
   "item": [
    {
     "name": "API-01 Retrieve catalogue",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/api/productsList",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "productsList"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test(\"HTTP status is 200\", () => { pm.response.to.have.status(200); });",
         "const body = pm.response.json();",
         "pm.test(\"Application responseCode is 200\", () => { pm.expect(body.responseCode).to.eql(200); });",
         "pm.test(\"Products have numeric IDs and catalogue fields\", () => { pm.expect(body.products).to.be.an(\"array\").that.is.not.empty;",
         "for (const row of body.products) {",
         "    pm.expect(row.id).to.be.a(\"number\");",
         "    pm.expect(row.name).to.be.a(\"string\").that.is.not.empty;",
         "    pm.expect(row.price).to.match(/^Rs\\. \\d+(?:\\.\\d+)?$/);",
         "    pm.expect(row.brand).to.be.a(\"string\");",
         "    pm.expect(row.category.category).to.be.a(\"string\");",
         "    pm.expect(row.category.usertype.usertype).to.be.a(\"string\");",
         "} });"
        ]
       }
      }
     ]
    },
    {
